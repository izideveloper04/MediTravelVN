# Leave WP_API_URL empty to run on the bundled sample content (content/seed.json).
WP_API_URL=
# Optional bearer token if the WordPress endpoint is protected.
WP_API_TOKEN=
# Shared secret WordPress sends to /api/revalidate. Use the same value in the plugin settings.
REVALIDATE_SECRET=
# Public address of this site, for canonical URLs.
SITE_URL=http://localhost:3000
